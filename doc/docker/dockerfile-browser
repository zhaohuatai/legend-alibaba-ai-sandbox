# Skill Browser Sandbox Docker Image
# 用于浏览器自动化操作的独立沙箱环境
# 
# 基于通用沙箱镜像，额外集成 Playwright 和 Chromium 浏览器
# 镜像大小：约 2.3GB

FROM skill-sandbox:latest

# 避免交互式安装提示
USER root

# === 第 1 步：安装 Playwright 系统依赖 ===
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 浏览器依赖库
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libxshmfence1 \
    libx11-xcb1 \
    libx11-6 \
    libxcb1 \
    libxext6 \
    libxfixes3 \
    libexpat1 \
    libffi8 \
    libdbus-1-3 \
    # 中文字体支持
    fonts-wqy-zenhei \
    fonts-wqy-microhei \
    # 清理缓存
    && rm -rf /var/lib/apt/lists/*

# === 第 2 步：安装 Playwright 和 MCP 服务器 ===
RUN npm install -g @playwright/mcp@latest

# === 第 3 步：下载 Chromium 浏览器 ===
RUN npx playwright install chromium

# === 第 4 步：安装 Playwright Python SDK（可选，用于 Python 脚本直接控制浏览器） ===
RUN pip3 install --no-cache-dir playwright && \
    pip3 cache purge

# === 第 5 步：设置权限 ===
RUN chown -R skill:skill /home/skill/.cache /home/skill/.npm /home/skill/.local

# === 第 6 步：切换回 skill 用户 ===
USER skill

# 暴露 Playwright MCP 服务端口（可选）
EXPOSE 3000

# 默认命令：保持容器运行
CMD ["sleep", "infinity"]
